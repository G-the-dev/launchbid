# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Token purchases: manual UPI. The QR is generated from this VPA.
NEXT_PUBLIC_UPI_VPA=yourname@bank

# Purchase-approval mail (owner's Gmail + app password, same pattern as pagehaul)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Where approval requests are sent (defaults to GMAIL_USER)
OWNER_EMAIL=
# Any long random string; signs the emailed approve links
PURCHASE_APPROVE_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
